# Ключ доступа пользователя, сообщества или сервисный ключ.
# Скопируйте этот файл в .env и подставьте свой ключ. Файл .env не коммитьте.
VK_TOKEN=

# Версия API. Актуальная на момент написания — 5.199.
VK_API_VERSION=5.199

# Короткое имя или числовой id сообщества: club123, public123 или my_group.
VK_GROUP_ID=

# Буквы, с которых должна начинаться фамилия.
# Можно через запятую или слитно: А,К,М или АКМ. Диапазоны вроде А-Я не раскрываются.
VK_LETTERS=А,К,М

# Куда записать CSV. Повторный запуск перезаписывает файл.
VK_OUTPUT=members.csv

# Пауза между успешными запросами, в секундах.
# 0.35 укладывается в лимит пользовательского ключа (3 запроса в секунду).
VK_REQUEST_DELAY=0.35
